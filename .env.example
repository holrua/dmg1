# Turso (مطلوب) — انسخ هذا الملف باسم .env محليًا، وأضف المتغيرين في Vercel عند النشر
TURSO_DATABASE_URL=libsql://your-db-yourorg.turso.io
TURSO_AUTH_TOKEN=your-turso-token

# اختياري — الحدود (القيم الافتراضية مذكورة)
MAX_SOURCES=10
SOURCE_MAX_MB=200
OUTPUT_MAX_MB=150
MAX_TOTAL_DURATION_SEC=600
FFMPEG_PRESET=medium
